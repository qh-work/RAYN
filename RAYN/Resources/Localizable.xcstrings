    "It feels cold. Keep warm, especially in the morning and evening." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es fühlt sich kalt an. Halten Sie sich warm, besonders morgens und abends."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It feels cold. Keep warm, especially in the morning and evening."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se siente frío. Manténgase abrigado, especialmente por la mañana y por la noche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il fait froid. Gardez au chaud, surtout le matin et le soir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fa freddo. Stare al caldo, soprattutto al mattino e alla sera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寒く感じます。特に朝晩は暖かくしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추워요. 특히 아침, 저녁에는 따뜻하게 지내십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感觉很冷。注意保暖，尤其是早上和晚上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感覺很冷。注意保暖，尤其是早上和晚上。"
          }
        }
      }
    },
    "It feels hot. Stay ventilated, hydrated, and protected from the sun." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es fühlt sich heiß an. Achten Sie auf Kühlung, ausreichend Flüssigkeit und Sonnenschutz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It feels hot. Stay ventilated, hydrated, and protected from the sun."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sensación es calurosa. Mantente en un lugar ventilado, hidrátate y protégete del sol."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chaleur est marquée. Restez au frais, hydratez-vous et protégez-vous du soleil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La temperatura percepita è elevata. Cerca ambienti ventilati, idratati e proteggiti dal sole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暑く感じられます。風通しのよい場所でこまめに水分を取り、日差しを避けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "덥게 느껴집니다. 시원한 곳에서 수분을 충분히 섭취하고 햇빛을 피하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "体感炎热，请注意通风、补充水分并做好防晒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "體感炎熱，請注意通風、補充水分並做好防曬。"
          }
        }
      }
    },
