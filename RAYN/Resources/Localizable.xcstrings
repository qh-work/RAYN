    "The day–night temperature range is about %@%@, so mornings and evenings will feel cooler." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Temperaturunterschied zwischen Tag und Nacht beträgt etwa %1$@%2$@. Morgens und abends fühlt es sich daher kühler an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The day–night temperature range is about %1$@%2$@, so mornings and evenings will feel cooler."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La diferencia de temperatura entre el día y la noche es de unos %1$@%2$@, por lo que refrescará por la mañana y por la noche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’amplitude thermique entre le jour et la nuit est d’environ %1$@%2$@ ; les matinées et les soirées seront donc plus fraîches."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’escursione termica tra giorno e notte è di circa %1$@%2$@, quindi mattina e sera saranno più fresche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "昼夜の気温差は約 %1$@%2$@で、朝晩はより涼しく感じられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일교차는 약 %1$@%2$@로, 아침과 저녁에는 더 서늘하게 느껴집니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "昼夜温差约为 %1$@%2$@，早晚体感会更凉。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "晝夜溫差約為 %1$@%2$@，早晚體感會更涼。"
          }
        }
      }
    },
