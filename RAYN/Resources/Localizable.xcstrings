    "Freezing precipitation may make roads and walkways slippery." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Gefrierender Niederschlag kann Straßen und Wege rutschig machen." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Freezing precipitation may make roads and walkways slippery." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "La precipitación helada puede hacer resbaladizos los caminos y las aceras." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les précipitations verglaçantes peuvent rendre les routes et les trottoirs glissants." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Le precipitazioni gelate possono rendere scivolose strade e marciapiedi." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "凍結する降水により、道路や歩道が滑りやすくなるおそれがあります。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "어는 비나 눈으로 도로와 보도가 미끄러울 수 있습니다." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "冻降水可能使道路和人行道变得湿滑。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "凍結性降水可能使道路和人行道變得濕滑。" } }
      }
    },
