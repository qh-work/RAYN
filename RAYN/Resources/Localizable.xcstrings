    "Keep Screen Awake" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildschirm eingeschaltet lassen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep Screen Awake"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantener la pantalla encendida"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garder l’écran allumé"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni lo schermo acceso"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面をスリープさせない"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면 항상 켜기"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持屏幕常亮"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持螢幕常亮"
          }
        }
      }
    },
    "Keeping the screen awake takes effect only when you enable it. Leaving Settings or turning it off restores the system default." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Bildschirm bleibt nur bei aktivierter Option eingeschaltet. Beim Schließen der Einstellungen oder Deaktivieren der Option gilt wieder das Standardverhalten des Systems."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeping the screen awake takes effect only when you enable it. Leaving Settings or turning it off restores the system default."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pantalla solo permanece encendida cuando esta opción está activada. Al cerrar Ajustes o desactivarla, se restablece el comportamiento predeterminado del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’écran reste allumé uniquement lorsque cette option est activée. Fermer les réglages ou désactiver l’option rétablit le comportement par défaut du système."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo schermo resta acceso solo quando questa opzione è attiva. Chiudendo Impostazioni o disattivandola viene ripristinato il comportamento predefinito del sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にした場合のみ画面をスリープさせません。設定を閉じるか、この機能をオフにするとシステムの標準動作に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기능을 켠 경우에만 화면이 항상 켜집니다. 설정을 닫거나 기능을 끄면 시스템 기본 동작으로 돌아갑니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后屏幕才会保持常亮。离开设置或关闭此功能后，将恢复系统默认行为。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後螢幕才會保持常亮。離開設定或關閉此功能後，將恢復系統預設行為。"
          }
        }
      }
    },
