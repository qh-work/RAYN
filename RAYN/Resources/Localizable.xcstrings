    "Air quality is suitable for outdoor activities. Sensitive groups can adjust as needed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Luftqualität ist für Outdoor-Aktivitäten geeignet. Sensible Gruppen können sich je nach Bedarf anpassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Air quality is suitable for outdoor activities. Sensitive groups can adjust as needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La calidad del aire es adecuada para actividades al aire libre. Los grupos sensibles pueden adaptarse según sea necesario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La qualité de l'air est adaptée aux activités de plein air. Les groupes sensibles peuvent s’adapter si nécessaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La qualità dell'aria è adatta per le attività all'aperto. I gruppi sensibili possono adeguarsi secondo necessità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大気質は屋外活動に適しています。敏感な方は体調に合わせて調整してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대기질은 야외 활동에 적합합니다. 민감군은 몸 상태에 맞춰 조절하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空气质量适合户外活动，敏感人群可根据自身情况调整。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空氣品質適合戶外活動，敏感族群可依自身情況調整。"
          }
        }
      }
    },
