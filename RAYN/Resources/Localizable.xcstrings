    "Afternoon UV levels are high. Use sun protection for extended outdoor activity." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachmittags sind die UV-Werte hoch. Verwenden Sie bei längeren Aktivitäten im Freien Sonnenschutz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afternoon UV levels are high. Use sun protection for extended outdoor activity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los niveles de UV por la tarde son altos. Utilice protección solar durante actividades prolongadas al aire libre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les niveaux d'UV de l'après-midi sont élevés. Utilisez une protection solaire pour les activités de plein air prolongées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I livelli UV pomeridiani sono elevati. Utilizzare la protezione solare per attività prolungate all'aperto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "午後の紫外線レベルは高くなっています。屋外で長時間活動する場合は、日焼け止めを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오후 자외선 수치가 높습니다. 장시간의 야외 활동에는 자외선 차단제를 사용하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下午紫外线水平很高。长时间户外活动时请使用防晒霜。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下午紫外線水準很高。長時間戶外活動時請使用防曬乳。"
          }
        }
      }
    },
