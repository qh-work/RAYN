    "Conditions feel comfortable. Layers make it easier to adjust." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Wetter ist angenehm. Mehrere Kleidungsschichten lassen sich leicht anpassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conditions feel comfortable. Layers make it easier to adjust."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tiempo es agradable. Vestirse por capas facilita adaptarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le temps est agréable. Superposez les vêtements pour vous adapter facilement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il clima è piacevole. Vestirsi a strati facilita l’adattamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快適な体感です。重ね着なら気温に合わせて調整しやすくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "쾌적한 날씨입니다. 겹쳐 입으면 기온에 맞춰 조절하기 쉽습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "体感舒适，叠穿更方便随温度调整。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "體感舒適，疊穿更方便隨溫度調整。"
          }
        }
      }
    },
    "Conditions feel mild. Choose light, breathable clothing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Wetter ist mild. Wählen Sie leichte, atmungsaktive Kleidung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
