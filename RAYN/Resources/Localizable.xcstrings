    "Swipe up or down through all dates. Press Select to open a forecast, and Menu to return to the list." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch alle Daten nach oben oder unten wischen. Drücken Sie „Auswählen“, um eine Vorhersage zu öffnen, und „Menü“, um zur Liste zurückzukehren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe up or down through all dates. Press Select to open a forecast, and Menu to return to the list."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza hacia arriba o hacia abajo por todas las fechas. Presione Seleccionar para abrir un pronóstico y Menú para regresar a la lista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser votre doigt vers le haut ou vers le bas pour parcourir toutes les dates. Appuyez sur Sélectionner pour ouvrir une prévision et sur Menu pour revenir à la liste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri verso l'alto o verso il basso attraverso tutte le date. Premere Seleziona per aprire una previsione e Menu per tornare all'elenco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上下にスワイプしてすべての日付を移動します。選択ボタンで予報を開き、メニューボタンで一覧に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위아래로 스와이프해 모든 날짜를 이동합니다. 선택 버튼으로 예보를 열고 메뉴 버튼으로 목록으로 돌아갑니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上下滑动浏览所有日期，按确认键打开预报，按菜单键返回列表。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上下滑動瀏覽所有日期，按確認鍵開啟預報，按選單鍵返回列表。"
          }
        }
      }
    },
    "Swipe up or down to choose a date · Press Select for details" : {
